# GitHub (agent uses this to push to the repo)
GH_USER=your-github-username
GH_EMAIL=your-github-email
GH_TOKEN=your-github-personal-access-token

# PostgreSQL
POSTGRES_DB=thesora
POSTGRES_USER=thesora
POSTGRES_PASSWORD=choose-a-strong-password

# App
DATABASE_URL=postgresql://thesora:choose-a-strong-password@postgres:5432/thesora
SECRET_KEY=choose-a-long-random-string-for-session-signing

# Test DB (used by pytest — must be a separate database)
TEST_DATABASE_URL=postgresql://thesora:choose-a-strong-password@localhost:5432/thesora_test
